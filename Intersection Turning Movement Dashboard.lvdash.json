{
  "datasets": [
    {
      "name": "61ce6f84",
      "displayName": "confirmed_total",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS confirmed_movement_count\n",
        "FROM traffic_project.gold.turning_movements\n",
        "WHERE movement_status = 'confirmed';"
      ],
      "catalog": "traffic_project",
      "schema": "gold"
    },
    {
      "name": "057ba3ea",
      "displayName": "movement_summary",
      "queryLines": [
        "SELECT\n",
        "  movement,\n",
        "  COUNT(*) AS vehicle_count\n",
        "FROM traffic_project.gold.turning_movements\n",
        "WHERE movement_status = 'confirmed'\n",
        "GROUP BY movement\n",
        "ORDER BY vehicle_count DESC;"
      ],
      "catalog": "traffic_project",
      "schema": "gold"
    },
    {
      "name": "028efe97",
      "displayName": "movement_details",
      "queryLines": [
        "SELECT\n",
        "  camera_id,\n",
        "  track_id,\n",
        "  movement,\n",
        "  entry_zone,\n",
        "  exit_zone,\n",
        "  entry_time,\n",
        "  exit_time\n",
        "FROM traffic_project.gold.turning_movements\n",
        "WHERE movement_status = 'confirmed'\n",
        "ORDER BY entry_time DESC;"
      ]
    }
  ],
